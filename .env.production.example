# Production profile — copy to your host secret manager / PaaS env (never commit real values)

APP_ENV=production
PORT=4000
LOG_LEVEL=info

# Public URLs (required for export bundles + Claude Code credentials)
PUBLIC_API_URL=https://api.your-domain.com
PUBLIC_WS_URL=wss://api.your-domain.com/ws
WEB_BASE_URL=https://app.your-domain.com

DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/architectai?sslmode=require
REDIS_URL=rediss://:PASSWORD@HOST:6379

# Auth (required)
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# LLM (required — mock is blocked in production)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL_INTERROGATION=claude-sonnet-4-20250514
LLM_MODEL_GENERATION=claude-opus-4-20250514
LLM_MODEL_ASSIST=claude-sonnet-4-20250514
LLM_SESSION_MAX_OUTPUT_TOKENS=50000

# Verification (v3)
VERIFICATION_ENABLED=true
VERIFICATION_TIER2_ENABLED=true

# Boot
RUN_MIGRATIONS_ON_BOOT=true
